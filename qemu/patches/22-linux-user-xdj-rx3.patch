diff --git a/linux-user/arm/target_proc.h b/linux-user/arm/target_proc.h
index a28d723..6dd7f91 100644
--- a/linux-user/arm/target_proc.h
+++ b/linux-user/arm/target_proc.h
@@ -91,10 +91,36 @@ static int open_cpuinfo(CPUArchState *cpu_env, int fd)
     }
 
     if (arch < 8) {
-        dprintf(fd, "Hardware\t: QEMU v%s %s\n", QEMU_VERSION,
-                cpu->dtb_compatible ? : "");
-        dprintf(fd, "Revision\t: 0000\n");
-        dprintf(fd, "Serial\t\t: 0000000000000000\n");
+        /*
+         * dj-emu: an emulated board can name itself. If the guest root has
+         * /etc/dj-emu/board, its "Hardware=", "Revision=" and "Serial="
+         * lines replace these three, as the board's own kernel would report
+         * them (the XDJ-RX3 player checks Revision for its board). Every
+         * other line still describes the emulated CPU.
+         */
+        char hw[128] = "", rev[32] = "0000", serial[32] = "0000000000000000";
+        FILE *f = fopen("/etc/dj-emu/board", "r");
+
+        snprintf(hw, sizeof(hw), "QEMU v%s %s", QEMU_VERSION,
+                 cpu->dtb_compatible ? : "");
+        if (f) {
+            char line[160];
+
+            while (fgets(line, sizeof(line), f)) {
+                line[strcspn(line, "\r\n")] = 0;
+                if (!strncmp(line, "Hardware=", 9)) {
+                    pstrcpy(hw, sizeof(hw), line + 9);
+                } else if (!strncmp(line, "Revision=", 9)) {
+                    pstrcpy(rev, sizeof(rev), line + 9);
+                } else if (!strncmp(line, "Serial=", 7)) {
+                    pstrcpy(serial, sizeof(serial), line + 7);
+                }
+            }
+            fclose(f);
+        }
+        dprintf(fd, "Hardware\t: %s\n", hw);
+        dprintf(fd, "Revision\t: %s\n", rev);
+        dprintf(fd, "Serial\t\t: %s\n", serial);
     }
     return 0;
 }
diff --git a/linux-user/main.c b/linux-user/main.c
