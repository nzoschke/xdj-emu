+    if (cpu_model == NULL) {
+        /*
+         * dj-emu: an emulated board can name its CPU in /etc/dj-emu/board
+         * ("Cpu=cortex-a9" for the XDJ-RX3's i.MX6 Quad); QEMU_CPU and -cpu
+         * still take precedence.
+         */
+        FILE *board = fopen("/etc/dj-emu/board", "r");
+
+        if (board) {
+            char line[160];
+
+            while (fgets(line, sizeof(line), board)) {
+                line[strcspn(line, "\r\n")] = 0;
+                if (!strncmp(line, "Cpu=", 4) && line[4]) {
+                    cpu_model = g_strdup(line + 4);
